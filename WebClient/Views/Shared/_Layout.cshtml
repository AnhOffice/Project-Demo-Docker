                            </li>
                            @* <li class="nav-item"> *@
                            @*     <a class="nav-link text-dark" asp-area="" asp-controller="StudentOdata" asp-action="Index"> odata </a> *@
                            @* </li> *@
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Authentication" asp-action="Login">Đăng nhập</a>
